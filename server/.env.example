# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/shaheen_center?schema=public"

# JWT Auth (Change in production)
# Access tokens are HS256 JWTs with a 15-minute default lifetime.
JWT_SECRET="replace-with-strong-random-jwt-secret-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_ISSUER="shaheen-center-api"
JWT_AUDIENCE="shaheen-center-client"

# Refresh tokens are opaque random strings (not JWTs). Only their SHA-256 hash
# is stored. JWT_REFRESH_SECRET is deprecated and no longer used.
JWT_REFRESH_SECRET="deprecated-not-used-by-opaque-refresh-tokens"
JWT_REFRESH_EXPIRES_IN="7d"

# Refresh cookie (HttpOnly, SameSite=Lax by default, Secure in production)
REFRESH_COOKIE_NAME="shaheen_refresh_token"
REFRESH_COOKIE_PATH="/api/auth"
REFRESH_COOKIE_SAMESITE="lax"

# Login lockout & rate limiting
AUTH_MAX_FAILED_ATTEMPTS="5"
AUTH_LOCKOUT_MINUTES="15"
LOGIN_RATE_LIMIT_WINDOW_MS="900000"
LOGIN_RATE_LIMIT_MAX="20"
REFRESH_RATE_LIMIT_WINDOW_MS="900000"
REFRESH_RATE_LIMIT_MAX="120"

# Set to "true" only behind a trusted reverse proxy so rate limiting sees real IPs.
TRUST_PROXY="false"
# Optional comma-separated extra trusted browser origins (CLIENT_URL is always trusted).
TRUSTED_ORIGINS=""

# AES-256-GCM National ID Encryption (EXACTLY 64 hex chars = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="replace-with-64-hex-characters-32-bytes"

# HMAC-SHA256 Blind Index Secret (for Admin search & duplicate check on encrypted National ID)
BLIND_INDEX_SECRET="replace-with-random-hmac-secret-for-national-id-search"

# Notifications MVP Mode: "MOCK" (stores SENT_MOCK in DB) | "QUEUED_ONLY" (leaves QUEUED)
NOTIFICATION_MODE="MOCK"
ZAGEL_API_URL=""
ZAGEL_API_KEY=""

# Initial Admin (used only by prisma/seed.js and scripts/verify-admin.js)
# Password must be at least 12 characters. Never commit the real .env file.
ADMIN_NAME="Shaheen Administrator"
ADMIN_PHONE="01XXXXXXXXX"
ADMIN_PASSWORD="replace-with-strong-admin-password-min-12-chars"

# Absolute refresh-session family lifetime (days).
REFRESH_SESSION_MAX_DAYS=30

# --- Testing (disposable DB; never points at dev/prod) ---
# TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/shaheen_center_test?schema=public"
PG_BIN="C:\\Program Files\\PostgreSQL\\19\\bin"

# --- Backup (CLI-only) ---
# BACKUP_DIR="C:\\path\\to\\backups"
# BACKUP_RETENTION_DAYS=14
# BACKUP_ENCRYPTION_PASSPHRASE=""
