# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shaheen_center?schema=public"

# JWT Auth (Change in production)
JWT_SECRET="replace-with-strong-random-jwt-secret-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-strong-random-refresh-secret-min-32-chars"
JWT_REFRESH_EXPIRES_IN="7d"

# AES-256-GCM National ID Encryption (EXACTLY 64 hex chars = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# HMAC-SHA256 Blind Index Secret (for Admin search & duplicate check on encrypted National ID)
BLIND_INDEX_SECRET="replace-with-random-hmac-secret-for-national-id-search"

# Notifications MVP Mode: "MOCK" (stores SENT_MOCK in DB) | "QUEUED_ONLY" (leaves QUEUED)
NOTIFICATION_MODE="MOCK"
ZAGEL_API_URL=""
ZAGEL_API_KEY=""
